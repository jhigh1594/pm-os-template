# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Slack Email Configuration
# Get your channel's email from Slack: Channel Settings > Integrations > "Send emails to this channel"
# Format: random-name@your-workspace.slack.com
SLACK_EMAIL=your-channel@your-workspace.slack.com

# SMTP Configuration (for sending emails)
# Gmail example (requires App Password if using 2FA)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here

# GenAI PM Configuration
# Subscribe free at https://genaipm.com
GENAIPM_EMAIL=your_email@example.com
