agileplace boards list [--search "name"] [--limit 50] [--format table]
agileplace boards get <board_id> [--format summary]
agileplace boards cards <board_id> [--lanes "id1,id2"] [--include-archived]
agileplace boards create --title "Board" [--description "..."] [--level 2]
agileplace boards archive <board_id>
agileplace boards batch-archive <board_ids_csv>
agileplace boards update <board_id> [--title] [--description]
agileplace boards update-layout <board_id> --layout @layout.json
agileplace boards get-custom-fields <board_id>
agileplace boards update-custom-fields <board_id> --updates @fields.json
agileplace boards export-history <board_id> [--out history.csv]
```

